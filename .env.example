# ICE environment (copy to .env for local dev). Never commit .env.

# --- Server ---
PORT=8080
PUBLIC_URL=http://localhost:3000

# --- AI agent ---
# Provider key for the coding agent. Anthropic by default; can be routed via a gateway.
ANTHROPIC_API_KEY=
ICE_AGENT_MODEL=claude-sonnet-4-6

# --- Realtime (Yjs sync) ---
ICE_YJS_PORT=1234

# --- Voice (LiveKit) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Git server ---
ICE_GIT_ROOT=./data/repos

# --- Database ---
DATABASE_URL=file:./data/ice.sqlite

# --- Auth ---
ICE_SESSION_SECRET=change-me-in-production

# Code conversion backup (separate Gemini key from the agent key)
GEMINI_CONVERT_API_KEY=
